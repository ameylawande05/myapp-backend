# ════════════════════════════════════════════════
#  DOUBLE A CLAIMS — Environment Variables
#  Copy this to .env and fill in your values
# ════════════════════════════════════════════════

# ── Server ───────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Frontend URL (for CORS + email links) ────────
# Local dev:  http://localhost:3000
# Production: https://doublea-claims.netlify.app
FRONTEND_URL=http://localhost:3000

# ── PostgreSQL Database ───────────────────────────
# Get from Supabase / Railway / Render / Neon
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/doublea_claims

# ── JWT Secret ────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_random_64_char_string_in_production

# ── File Storage ──────────────────────────────────
# Option A: AWS S3 (recommended for production)
STORAGE_TYPE=local
# STORAGE_TYPE=s3

AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=doublea-claims-files

# Local storage path (used when STORAGE_TYPE=local)
UPLOAD_DIR=./uploads

# ── SendGrid Email ────────────────────────────────
# Get free API key at sendgrid.com (100 emails/day free)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
EMAIL_FROM=noreply@doublea-claims.com
EMAIL_FROM_NAME=Double A Claims Platform

# ── Super Admin (auto-created on first startup) ───
SUPER_ADMIN_EMAIL=ameylawande05@gmail.com
SUPER_ADMIN_PASSWORD=Doublea0511
SUPER_ADMIN_NAME=Amey Lawande
